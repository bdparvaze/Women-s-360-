    <string name="bra_step1_tts_bn">ধাপ ১, নিচের মাপ। একা ঘরে আয়নার সামনে সোজা হয়ে দাঁড়ান। টি-শার্টের উপর দিয়ে বুকের ঠিক নিচে হলুদ ফিতা ধরুন। ফিতার নিচে এক আঙুল ফাঁকা রাখুন যেন বেশি টাইট না হয়।</string>
    <string name="bra_step2_tts_bn">ধাপ ২, উপরের মাপ। টি-শার্টের উপর দিয়ে বুকের সবচেয়ে উঁচু জায়গায় ফিতা গোল করে ধরুন। ফিতা যেন ঢিলা বা বেশি টাইট না হয়।</string>
    <string name="bra_step3_tts_bn">ধাপ ৩, পাশ থেকে চেক করুন। আয়নায় পাশ ফিরে দেখুন ফিতাটি পিঠের দিকে উপরে উঠে গেছে কিনা। ফিতা মেঝের সাথে একদম সোজা ও সমান্তরাল রাখুন।</string>
