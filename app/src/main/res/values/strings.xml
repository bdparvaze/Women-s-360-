    <string name="diet_plan_heading">Cycle-Synced Auto Diet Plan</string>
    <string name="diet_menstrual_title">Menstrual Phase: Iron &amp; Warmth</string>
    <string name="diet_menstrual_foods">Spinach, lentils, dates, ginger tea, dark chocolate (70%%+), and warm soups to replenish iron and soothe cramps.</string>
    <string name="diet_follicular_title">Follicular Phase: Fresh &amp; Light</string>
    <string name="diet_follicular_foods">Avocado, citrus fruits, oats, pumpkin seeds, probiotic yogurt, and leafy greens to support rising estrogen.</string>
    <string name="diet_ovulatory_title">Ovulatory Phase: Antioxidant Glow</string>
    <string name="diet_ovulatory_foods">Berries, almonds, quinoa, bell peppers, flaxseeds, and plenty of electrolyte-rich hydration.</string>
    <string name="diet_luteal_title">Luteal Phase: Magnesium &amp; Complex Carbs</string>
    <string name="diet_luteal_foods">Sweet potatoes, bananas, walnuts, chickpeas, chamomile tea, and sunflower seeds to curb PMS cravings.</string>

